<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ZeroKey" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@color/page_background</item>
        <item name="android:colorAccent">@color/action</item>
        <item name="colorAccent">@color/action</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:statusBarColor">@color/page_background</item>
        <item name="android:navigationBarColor">@color/page_background</item>
    </style>
    <style name="Theme.ZeroKey.Vault">
        <item name="android:windowAnimationStyle">@style/Animation.ZeroKey.Tabs</item>
    </style>
    <style name="Animation.ZeroKey.Tabs" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/tab_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/tab_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/tab_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/tab_exit</item>
    </style>
    <style name="ThemeOverlay.ZeroKey.RecipeMenu" parent="">
        <item name="listPopupWindowStyle">@style/Widget.ZeroKey.RecipeMenu</item>
    </style>
    <style name="Widget.ZeroKey.RecipeMenu" parent="Widget.AppCompat.ListPopupWindow">
        <item name="android:popupEnterTransition">@null</item>
    </style>
    <string name="app_name">ZeroKey</string>
</resources>
